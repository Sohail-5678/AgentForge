# Control plane (Vercel) — SPEC §17.1. Everything is optional: without DATABASE_URL the site serves the demo snapshot read-only.
DATABASE_URL=                 # Neon project "agentforge", pooled connection string
AUTH_SECRET=                  # openssl rand -base64 32
AUTH_GITHUB_ID=               # GitHub OAuth App (callback https://<host>/api/auth/callback/github)
AUTH_GITHUB_SECRET=
ADMIN_GITHUB_USERS=Sohail-5678
GH_TOKEN=                     # fine-grained PAT: AgentForge Actions r/w; target repos statuses + PR comments
GH_OWNER=Sohail-5678
GH_AGENTFORGE_REPO=AgentForge
RUNNER_KEY_HASH=              # sha256(AF_RUNNER_KEY) — `pnpm keys:create --runner`
NEXT_PUBLIC_SITE_URL=https://agentforge-eval.vercel.app
TRACE_SAMPLE_SUCCESS=0.2
TRACE_RETENTION_DAYS=30
PR_GATE_CALLS=150
NIGHTLY_CALLS_RETURNPILOT=300
NIGHTLY_CALLS_DATAPILOT=300
